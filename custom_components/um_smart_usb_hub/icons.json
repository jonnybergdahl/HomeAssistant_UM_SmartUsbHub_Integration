{
  "entity": {
    "binary_sensor": {
      "main_5v": {
        "default": "mdi:power-plug",
        "state": {
          "off": "mdi:power-plug-off"
        }
      },
      "upstream_5v": {
        "default": "mdi:usb",
        "state": {
          "off": "mdi:usb-flash-drive-outline"
        }
      },
      "clock_synced": {
        "default": "mdi:clock-check-outline",
        "state": {
          "off": "mdi:clock-alert-outline"
        }
      },
      "connected": {
        "default": "mdi:usb-port"
      },
      "overcurrent": {
        "default": "mdi:flash-alert"
      }
    },
    "button": {
      "all_ports_on": {
        "default": "mdi:power-plug-battery"
      },
      "all_ports_off": {
        "default": "mdi:power-plug-off"
      },
      "detect_location": {
        "default": "mdi:map-marker-radius"
      },
      "power_cycle": {
        "default": "mdi:restart"
      }
    },
    "number": {
      "led_brightness": {
        "default": "mdi:brightness-6"
      },
      "utc_offset": {
        "default": "mdi:map-clock"
      }
    },
    "select": {
      "power_mode": {
        "default": "mdi:power-settings",
        "state": {
          "manual": "mdi:hand-back-right",
          "boot": "mdi:power",
          "connect": "mdi:usb-port"
        }
      },
      "averaging": {
        "default": "mdi:chart-bell-curve"
