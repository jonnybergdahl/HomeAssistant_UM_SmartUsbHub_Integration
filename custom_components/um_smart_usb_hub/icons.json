      "button_press": {
        "default": "mdi:gesture-tap",
        "state": {
          "toggle_ports": "mdi:swap-horizontal",
          "all_on": "mdi:power-plug-battery",
          "all_off": "mdi:power-plug-off",
          "cycle_ports": "mdi:restart",
          "toggle_leds": "mdi:led-on",
          "toggle_s3_usb": "mdi:usb"
        }
      },
      "button_double_press": {
        "default": "mdi:gesture-double-tap",
        "state": {
          "toggle_ports": "mdi:swap-horizontal",
          "all_on": "mdi:power-plug-battery",
          "all_off": "mdi:power-plug-off",
          "cycle_ports": "mdi:restart",
          "toggle_leds": "mdi:led-on",
          "toggle_s3_usb": "mdi:usb"
        }
      },
      "button_long_press": {
        "default": "mdi:gesture-tap-hold",
        "state": {
          "toggle_ports": "mdi:swap-horizontal",
          "all_on": "mdi:power-plug-battery",
          "all_off": "mdi:power-plug-off",
          "cycle_ports": "mdi:restart",
          "toggle_leds": "mdi:led-on",
          "toggle_s3_usb": "mdi:usb"
        }
      }
    },
    "sensor": {
      "ports_powered": {
        "default": "mdi:usb-port"
      },
      "ports_occupied": {
        "default": "mdi:usb"
      },
      "ports_faulted": {
        "default": "mdi:flash-alert"
      },
      "reset_reason": {
        "default": "mdi:restart-alert"
      },
      "ip_address": {
        "default": "mdi:ip-network"
      },
      "ssid": {
        "default": "mdi:wifi"
      },
      "heap_free": {
        "default": "mdi:memory"
      },
      "last_restart": {
        "default": "mdi:restart"
      },
      "led_state": {
        "default": "mdi:led-on",
        "state": {
          "off": "mdi:led-off",
          "fault": "mdi:alert-circle"
        }
      },
      "schedule_rules": {
        "default": "mdi:calendar-clock"
      },
      "next_schedule": {
        "default": "mdi:calendar-clock"
      }
