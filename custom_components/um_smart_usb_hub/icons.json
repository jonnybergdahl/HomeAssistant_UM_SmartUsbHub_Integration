    "switch": {
      "port_power": {
        "default": "mdi:usb-port"
      },
      "leds": {
        "default": "mdi:led-on",
        "state": {
          "off": "mdi:led-off"
        }
      },
      "esphome_api": {
        "default": "mdi:home-assistant"
      },
      "s3_usb": {
        "default": "mdi:usb",
        "state": {
          "off": "mdi:usb-flash-drive-outline"
        }
      },
      "s3_usb_disconnect_on_boot": {
        "default": "mdi:power-plug-off-outline"
      }
    },
    "text": {
      "port_name": {
        "default": "mdi:rename"
      }
    }
