  "services": {
    "power_cycle": {
      "name": "Power cycle",
      "description": "Switches a port off, waits, and switches it back on.",
      "fields": {
        "off_time": {
          "name": "Off time",
          "description": "How long the port stays off, in seconds."
        }
      }
    },
    "get_schedule": {
      "name": "Get schedule",
      "description": "Returns the schedule stored on the hub for a port."
    },
    "clear_schedule": {
      "name": "Clear schedule",
      "description": "Removes all schedule rules from a port."
    },
    "set_schedule": {
      "name": "Set schedule",
      "description": "Replaces a port's schedule on the hub. The other ports are left unchanged.",
      "fields": {
        "entries": {
          "name": "Entries",
          "description": "List of rules. Each has days, time and mode, and optionally duration, until, every, all_day, once and enabled."
        }
      }
    },
    "add_schedule_entry": {
      "name": "Add schedule entry",
      "description": "Adds one rule to a port's schedule on the hub.",
      "fields": {
        "days": {
          "name": "Days",
          "description": "Weekdays the rule applies to."
        },
        "time": {
          "name": "Time",
          "description": "When the rule fires (hub local time). For a windowed repeating rule, the window start."
        },
        "mode": {
          "name": "Mode",
          "description": "What the rule does."
        },
        "duration": {
          "name": "Duration",
          "description": "Minutes on, for 'On for' and the pulse length of 'Repeat'."
        },
        "until": {
          "name": "Until",
          "description": "End time for 'On until', or the window end of a 'Repeat' rule that isn't all day."
        },
        "every": {
          "name": "Every",
          "description": "Repeat interval in minutes for 'Repeat' (minimum 30)."
        },
        "all_day": {
          "name": "All day",
          "description": "For 'Repeat': repeat all day, or only between Time and Until."
        },
        "once": {
          "name": "Once",
          "description": "Fire at the next occurrence, then disable the rule."
        },
        "enabled": {
          "name": "Enabled",
          "description": "Disabled rules are kept but ignored."
        }
      }
    }
  }
